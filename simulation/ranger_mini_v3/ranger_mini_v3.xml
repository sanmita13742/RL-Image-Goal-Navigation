<mujoco model="ranger_mini_v3">

  <!--
    ranger_mini_v3.xml  —  Ranger Mini V3 MuJoCo MJCF
    =================================================
    AgileX Ranger Mini 3.0 (V3) — 4WD4WS Omni-Directional
    Architecture: 4-Wheel Drive + 4-Wheel Steering (4WD4WS)

    Physical specs (from AgileX spec sheet):
      Chassis    : 720 × 500 × 345 mm,  75 kg
      Wheels     : radius 165mm, width 100mm, ~8 kg each
      Ground clr : 105 mm
      Max speed  : 2.0 m/s
      Steering   : 4x 100W harmonic drives, continuous [-π, π]
      Drive      : 4x 350W brushless motors

    Joint naming:
      fl_steering_joint / fl_wheel  (front-left)
      fr_steering_joint / fr_wheel  (front-right)
      rl_steering_joint / rl_wheel  (rear-left)
      rr_steering_joint / rr_wheel  (rear-right)

    Kinematic tree (per corner):
      base_link
        └─ steering_link  (hinge, Z-down, position actuator)
             └─ wheel_link (hinge, Y-axis, velocity actuator)
                           dropped 0.165m below steering pivot

    Key dimensions:
      Wheelbase   : 0.421 m  (±0.2105 m from centre)
      Track width : 0.600 m  (±0.300 m from centre)
      Wheel radius: 0.165 m
      Steer drop  : 0.1125 m (steering mount below chassis centre)
      Wheel drop  : 0.165 m  (wheel centre below steering pivot)
      Base Z      : 0.4425 m (0.1125 + 0.165 + 0.165)
  -->

  <compiler angle="radian"/>

  <!-- Physics: small timestep for wheel-ground stability -->
  <option timestep="0.004" integrator="RK4" gravity="0 0 -9.81"/>

  <default>
    <joint damping="1.0" armature="0.01"/>
    <!-- Good tire-like friction with proper contact parameters -->
    <geom friction="1.2 0.005 0.0001" condim="4" solimp="0.95 0.99 0.001" solref="0.01 1"/>
  </default>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker"
             rgb1="0.25 0.25 0.25" rgb2="0.35 0.35 0.35" width="512" height="512"/>
    <material name="floor_mat"    texture="floor_tex" texrepeat="10 10"/>

    <material name="chassis_mat"  rgba="0.79 0.82 0.93 1"/>
    <material name="wheel_mat"    rgba="0.12 0.12 0.12 1"/>
    <material name="steering_mat" rgba="0.30 0.30 0.35 1"/>
    <material name="cam_mat"      rgba="0.9 0.2 0.1 1"/>
  </asset>

  <worldbody>
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="30 30 0.1"
          material="floor_mat" friction="1.2 0.005 0.0001" contype="1" conaffinity="3"/>

    <!-- Lighting -->
    <light name="sun" pos="0 0 8" dir="0 0 -1" diffuse="0.85 0.85 0.85" specular="0.2 0.2 0.2" castshadow="true"/>
    <light name="fill" pos="-3 3 4" dir="0.4 -0.5 -0.8" diffuse="0.3 0.3 0.3" specular="0.0 0.0 0.0" castshadow="false"/>

    <!-- ======================= RANGER MINI V3 ======================= -->
    <!--
      Base height calculation:
        steer_drop = 0.1125 m (steering pivot below chassis centre)
        wheel_drop = 0.165 m  (wheel centre below steering pivot)
        wheel_rad  = 0.165 m
        base_z = steer_drop + wheel_drop + wheel_rad = 0.4425 m
    -->
    <body name="base_link" pos="0 0 0.2775">

      <!-- 6-DOF free joint so the robot moves in the world -->
      <freejoint name="root"/>

      <!-- Chassis inertia (Spec: 75 kg, 720x500x345 mm box) -->
      <inertial pos="-0.02 -0.003 0.05" mass="43"
                diaginertia="1.3 1.3 1.3"/>

      <!-- Chassis collision box (Spec: 720x500x345 mm, half-sizes 0.36x0.25x0.1725) -->
      <geom name="chassis_box" type="box" size="0.36 0.25 0.1725"
            pos="0 0 0" material="chassis_mat" contype="1" conaffinity="1"/>

      <!-- IMU site (at base centre) -->
      <site name="imu_site" pos="0 0 0" size="0.01"/>

      <!-- ── Front RGB Camera ───────────────────────────────────────────── -->
      <body name="camera_link" pos="0.36 0 0.10">
        <geom name="cam_marker" type="box" size="0.015 0.02 0.015" material="cam_mat" contype="0" conaffinity="0"/>
        <camera name="front_cam" fovy="80" xyaxes="0 -1 0 0 0 1"/>
      </body>

      <!-- ── LiDAR mount (simulated as depth camera) ───────────────────── -->
      <body name="lidar_link" pos="0.36 0 0.20">
        <geom name="lidar_marker" type="cylinder" size="0.03 0.02" material="cam_mat" contype="0" conaffinity="0"/>
        <!-- Narrow vertical FOV to avoid seeing floor, wide aspect ratio for horizontal sweep -->
        <camera name="lidar_cam" fovy="15" xyaxes="0 -1 0 0 0 1"/>
      </body>

      <!-- ═══════════ FRONT-LEFT CORNER ═════════════════════════════════
           Steering mount: x=+0.2105  y=+0.300  z=-0.1125
      -->
      <body name="fl_suspension_link" pos="0.247 0.182 0.0">
        <inertial pos="0 0 0" mass="2" diaginertia="0.01 0.01 0.01"/>
        <joint name="fl_suspension_joint" type="slide" axis="0 0 1" stiffness="10500" damping="500"/>
        <body name="fl_steering_wheel_link" pos="0 0 -0.1775">
          <joint name="fl_steering_joint" type="hinge" axis="0 0 -1"
                 limited="false"
                 damping="5.0" armature="1.0"/>
          <inertial pos="0 0 -0.04" mass="1"
                    diaginertia="0.01 0.01 0.01"/>
          <geom name="fl_knuckle" type="cylinder" size="0.025 0.06"
                pos="0 0 -0.06" material="steering_mat"
                contype="0" conaffinity="0"/>

          <!-- Wheel: steering pivot passes through wheel center for 0 scrub radius -->
          <body name="fl_wheel_link" pos="0 0 0">
            <joint name="fl_wheel" type="hinge" axis="0 1 0"
                   limited="false" damping="0.5"/>
            <inertial pos="0 0 0" mass="5"
                      diaginertia="0.04 0.07 0.04"/>
            <!-- Spec: radius 0.165, half-width 0.05 -->
            <geom name="fl_wheel_col" type="cylinder" size="0.100 0.05"
                  euler="1.5708 0 0" material="wheel_mat"
                  contype="2" conaffinity="2"/>
          </body>
        </body>
      </body>

      <!-- ═══════════ FRONT-RIGHT CORNER ════════════════════════════════
           Steering mount: x=+0.2105  y=-0.300  z=-0.1125
      -->
      <body name="fr_suspension_link" pos="0.247 -0.182 0.0">
        <inertial pos="0 0 0" mass="2" diaginertia="0.01 0.01 0.01"/>
        <joint name="fr_suspension_joint" type="slide" axis="0 0 1" stiffness="10500" damping="500"/>
        <body name="fr_steering_wheel_link" pos="0 0 -0.1775">
          <joint name="fr_steering_joint" type="hinge" axis="0 0 -1"
                 limited="false"
                 damping="5.0" armature="1.0"/>
          <inertial pos="0 0 -0.04" mass="1"
                    diaginertia="0.01 0.01 0.01"/>
          <geom name="fr_knuckle" type="cylinder" size="0.025 0.06"
                pos="0 0 -0.06" material="steering_mat"
                contype="0" conaffinity="0"/>

          <body name="fr_wheel_link" pos="0 0 0">
            <joint name="fr_wheel" type="hinge" axis="0 1 0"
                   limited="false" damping="0.5"/>
            <inertial pos="0 0 0" mass="5"
                      diaginertia="0.04 0.07 0.04"/>
            <geom name="fr_wheel_col" type="cylinder" size="0.100 0.05"
                  euler="1.5708 0 0" material="wheel_mat"
                  contype="2" conaffinity="2"/>
          </body>
        </body>
      </body>

      <!-- ═══════════ REAR-LEFT CORNER ══════════════════════════════════
           Steering mount: x=-0.2105  y=+0.300  z=-0.1125
      -->
      <body name="rl_suspension_link" pos="-0.247 0.182 0.0">
        <inertial pos="0 0 0" mass="2" diaginertia="0.01 0.01 0.01"/>
        <joint name="rl_suspension_joint" type="slide" axis="0 0 1" stiffness="10500" damping="500"/>
        <body name="rl_steering_wheel_link" pos="0 0 -0.1775">
          <joint name="rl_steering_joint" type="hinge" axis="0 0 -1"
                 limited="false"
                 damping="5.0" armature="1.0"/>
          <inertial pos="0 0 -0.04" mass="1"
                    diaginertia="0.01 0.01 0.01"/>
          <geom name="rl_knuckle" type="cylinder" size="0.025 0.06"
                pos="0 0 -0.06" material="steering_mat"
                contype="0" conaffinity="0"/>

          <body name="rl_wheel_link" pos="0 0 0">
            <joint name="rl_wheel" type="hinge" axis="0 1 0"
                   limited="false" damping="0.5"/>
            <inertial pos="0 0 0" mass="5"
                      diaginertia="0.04 0.07 0.04"/>
            <geom name="rl_wheel_col" type="cylinder" size="0.100 0.05"
                  euler="1.5708 0 0" material="wheel_mat"
                  contype="2" conaffinity="2"/>
          </body>
        </body>
      </body>

      <!-- ═══════════ REAR-RIGHT CORNER ═════════════════════════════════
           Steering mount: x=-0.2105  y=-0.300  z=-0.1125
      -->
      <body name="rr_suspension_link" pos="-0.247 -0.182 0.0">
        <inertial pos="0 0 0" mass="2" diaginertia="0.01 0.01 0.01"/>
        <joint name="rr_suspension_joint" type="slide" axis="0 0 1" stiffness="10500" damping="500"/>
        <body name="rr_steering_wheel_link" pos="0 0 -0.1775">
          <joint name="rr_steering_joint" type="hinge" axis="0 0 -1"
                 limited="false"
                 damping="5.0" armature="1.0"/>
          <inertial pos="0 0 -0.04" mass="1"
                    diaginertia="0.01 0.01 0.01"/>
          <geom name="rr_knuckle" type="cylinder" size="0.025 0.06"
                pos="0 0 -0.06" material="steering_mat"
                contype="0" conaffinity="0"/>

          <body name="rr_wheel_link" pos="0 0 0">
            <joint name="rr_wheel" type="hinge" axis="0 1 0"
                   limited="false" damping="0.5"/>
            <inertial pos="0 0 0" mass="5"
                      diaginertia="0.04 0.07 0.04"/>
            <geom name="rr_wheel_col" type="cylinder" size="0.100 0.05"
                  euler="1.5708 0 0" material="wheel_mat"
                  contype="2" conaffinity="2"/>
          </body>
        </body>
      </body>

    </body> <!-- /base_link -->

  </worldbody>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ACTUATORS
       ─────────────────────────────────────────────────────────────────────
       Steering: position actuators (kp=200) → target angle in radians
       Drive:    velocity actuators (kv=100) → target wheel speed in rad/s

       Order (matches Python ctrl[] indexing):
         ctrl[0]  act_fl_steer   fl_steering_joint
         ctrl[1]  act_fr_steer   fr_steering_joint
         ctrl[2]  act_rl_steer   rl_steering_joint
         ctrl[3]  act_rr_steer   rr_steering_joint
         ctrl[4]  act_fl_drive   fl_wheel
         ctrl[5]  act_fr_drive   fr_wheel
         ctrl[6]  act_rl_drive   rl_wheel
         ctrl[7]  act_rr_drive   rr_wheel
  ═══════════════════════════════════════════════════════════════════════════ -->
  <actuator>
    <!-- Steering position actuators (100W harmonic drives) -->
    <position name="act_fl_steer" joint="fl_steering_joint" kp="50" forcerange="-20 20" ctrlrange="-3.14159 3.14159"/>
    <position name="act_fr_steer" joint="fr_steering_joint" kp="50" forcerange="-20 20" ctrlrange="-3.14159 3.14159"/>
    <position name="act_rl_steer" joint="rl_steering_joint" kp="50" forcerange="-20 20" ctrlrange="-3.14159 3.14159"/>
    <position name="act_rr_steer" joint="rr_steering_joint" kp="50" forcerange="-20 20" ctrlrange="-3.14159 3.14159"/>

    <!-- Drive velocity actuators (350W brushless motors) -->
    <velocity name="act_fl_drive" joint="fl_wheel" kv="50" forcerange="-20 20" ctrlrange="-20 20"/>
    <velocity name="act_fr_drive" joint="fr_wheel" kv="50" forcerange="-20 20" ctrlrange="-20 20"/>
    <velocity name="act_rl_drive" joint="rl_wheel" kv="50" forcerange="-20 20" ctrlrange="-20 20"/>
    <velocity name="act_rr_drive" joint="rr_wheel" kv="50" forcerange="-20 20" ctrlrange="-20 20"/>
  </actuator>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SENSORS
  ═══════════════════════════════════════════════════════════════════════════ -->
  <sensor>
    <accelerometer name="imu_accel" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
    <jointvel name="fl_wheel_vel" joint="fl_wheel"/>
    <jointvel name="fr_wheel_vel" joint="fr_wheel"/>
    <jointvel name="rl_wheel_vel" joint="rl_wheel"/>
    <jointvel name="rr_wheel_vel" joint="rr_wheel"/>
    <jointpos name="fl_steer_pos" joint="fl_steering_joint"/>
    <jointpos name="fr_steer_pos" joint="fr_steering_joint"/>
    <jointpos name="rl_steer_pos" joint="rl_steering_joint"/>
    <jointpos name="rr_steer_pos" joint="rr_steering_joint"/>
  </sensor>

</mujoco>
