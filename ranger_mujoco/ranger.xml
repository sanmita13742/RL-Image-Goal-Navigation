<mujoco model="ranger_mini">

  <!--
    ranger.xml  —  Ranger Mini MuJoCo MJCF
    =======================================
    Converted from ranger_desription.urdf (AgileX Robotics Ranger Mini)
    with primitive collision geometry for stable physics.

    Architecture: 4-Wheel Drive + 4-Wheel Steering (4WD4WS)
    ─────────────────────────────────────────────────────────
    Each corner has:
      1. A STEERING JOINT  (revolute, about Z-down)   ← position actuator
      2. A WHEEL JOINT     (continuous, about Y)       ← velocity actuator

    Joint naming follows URDF:
      fr_steering_joint   / fr_wheel_joint    (front-right)
      fl_steering_joint   / fl_wheel_joint    (front-left)
      rl_steering_joint   / rl_wheel_joint    (rear-left)
      rr_steering_joint   / rr_wheel_joint    (rear-right)

    Key dimensions (from URDF):
      Wheelbase  : 0.890 m  (±0.445 m from centre)
      Track width: 0.560 m  (±0.280 m from centre)
      Wheel drop : ~0.292 m below steering mount
      Wheel radius: ~0.16 m  (estimated from visual mesh bounds)
      Base mass  : 88.76 kg
      Per-wheel  : 11.47 kg
  -->

  <compiler angle="radian" meshdir="meshes/"/>

  <!-- Physics: small timestep for wheel-ground stability -->
  <option timestep="0.004" integrator="RK4" gravity="0 0 -9.81"/>

  <default>
    <joint damping="1.0" armature="0.01"/>
    <!-- Good tire-like friction -->
    <geom friction="1.2 0.01 0.001" condim="4" solimp="0.9 0.95 0.001" solref="0.02 1"/>
  </default>

  <asset>
    <!-- Floor -->
    <texture name="floor_tex" type="2d" builtin="checker"
             rgb1="0.25 0.25 0.25" rgb2="0.35 0.35 0.35" width="512" height="512"/>
    <material name="floor_mat"    texture="floor_tex" texrepeat="10 10"/>

    <!-- Robot materials -->
    <material name="chassis_mat"  rgba="0.18 0.18 0.18 1"/>
    <material name="wheel_mat"    rgba="0.12 0.12 0.12 1"/>
    <material name="steering_mat" rgba="0.30 0.30 0.35 1"/>
    <material name="cam_mat"      rgba="0.9  0.2  0.1  1"/>
    <material name="lidar_mat"    rgba="0.1  0.6  0.9  1"/>
  </asset>

  <worldbody>

    <!-- Ground plane -->
    <geom name="floor" type="plane" size="30 30 0.1"
          material="floor_mat" friction="1.2 0.01 0.001"/>

    <!-- Lighting -->
    <light name="sun"   pos="0 0 8"  dir="0 0 -1"
           diffuse="0.85 0.85 0.85" specular="0.2 0.2 0.2" castshadow="true"/>
    <light name="fill"  pos="-3 3 4" dir="0.4 -0.5 -0.8"
           diffuse="0.3 0.3 0.3"   specular="0.0 0.0 0.0" castshadow="false"/>

    <!-- ═══════════════════════════ RANGER MINI ═══════════════════════════ -->
    <!--
      base_link sits at z=0.31 so wheels (z-drop 0.292 m) sit at z=0.018 m,
      wheel radius 0.16 m → bottom of wheel at z = 0.018-0.16 = -0.14 → but
      we use z=0.34 so the cylinder (radius 0.16) bottom lands at z≈0.
      Calculated: steering z-offset = 0.0335 above base, wheel drop = 0.292,
      wheel origin from base = 0.0335 - 0.292 = -0.2585 → need base at 0.32
      to clear ground (0.32 - 0.2585 - 0.16 ≈ -0.0, add small margin → z=0.34)
    -->
    <body name="base_link" pos="0 0 0.34">

      <!-- 6-DOF free joint so the robot moves in the world -->
      <freejoint name="root"/>

      <!-- Chassis inertia from URDF base_link inertial -->
      <inertial pos="-0.0169 0.0068 0.0578"
                mass="88.757"
                fullinertia="1.7123 4.9003 6.3943 0.0111 -0.0194 -0.0001"/>

      <!-- Chassis collision: approximate box (L×W×H = 0.9×0.56×0.25 half-sizes) -->
      <geom name="chassis_box" type="box"
            size="0.42 0.22 0.12"
            pos="0 0 0.02"
            material="chassis_mat"/>

      <!-- IMU site (at base centre) -->
      <site name="imu_site" pos="0 0 0" size="0.01"/>

      <!-- ── Front RGB Camera ───────────────────────────────────────────── -->
      <!--
        Mounted at front of chassis, elevated 0.15 m, looking forward.
        MuJoCo cameras look in -Z by default, so euler="0 90° 0" makes it
        look in +X (robot forward).
      -->
      <body name="camera_link" pos="0.65 0 0.20">
        <geom name="cam_marker" type="box" size="0.025 0.035 0.020"
              material="cam_mat" contype="0" conaffinity="0"/>
        <camera name="front_cam" fovy="80" xyaxes="0 -1 0 0 0 1"/>
      </body>

      <!-- ── LiDAR mount (simulated as depth camera) ───────────────────── -->
      <body name="lidar_link" pos="0.65 0 0.25">
        <geom name="lidar_marker" type="cylinder" size="0.05 0.03"
              material="lidar_mat" contype="0" conaffinity="0"/>
        <!-- Depth-camera approximation of a 2D LiDAR sweep -->
        <camera name="lidar_cam" fovy="1.0" xyaxes="0 -1 0 0 0 1"/>
      </body>

      <!-- ═══════════ FRONT-RIGHT CORNER ═══════════════════════════════════
           Steering mount: x= 0.445  y=-0.280  z= 0.0335  (from URDF)
           Wheel drop from steering mount: z = -0.2918
      -->
      <body name="fr_steering_link" pos="0.445 -0.280 0.0335">
        <joint name="fr_steering_joint" type="hinge" axis="0 0 -1"
               range="-0.6109 0.6109"
               damping="5.0" armature="0.05"/>
        <inertial pos="0.0001118 -0.0073218 -0.085228"
                  mass="2.0957"
                  fullinertia="0.0077827 0.0012664 0.0079221 1.29e-8 7.56e-7 -3.99e-6"/>
        <!-- Steering knuckle visual -->
        <geom name="fr_knuckle" type="cylinder" size="0.025 0.06"
              pos="0 0 -0.06" material="steering_mat"
              contype="0" conaffinity="0"/>

        <!-- Wheel -->
        <body name="fr_wheel_link" pos="0 0.001 -0.2918">
          <!-- URDF rpy="1.5708 0 0" → wheel spins about Y in MJCF (was local Z after rotation) -->
          <joint name="fr_wheel_joint" type="hinge" axis="0 1 0"
                 limited="false" damping="0.5"/>
          <inertial pos="-0.00095 0 0.0021"
                    mass="11.468"
                    fullinertia="0.05332 0.08008 0.11423 3.09e-9 8.27e-7 2.15e-7"/>
          <geom name="fr_wheel_col" type="cylinder" size="0.160 0.055"
                euler="1.5708 0 0" material="wheel_mat"/>
        </body>
      </body>

      <!-- ═══════════ FRONT-LEFT CORNER ════════════════════════════════════
           Steering mount: x= 0.445  y= 0.280  z= 0.0335
           Wheel drop: z = -0.29345
      -->
      <body name="fl_steering_wheel_link" pos="0.445 0.280 0.0335">
        <joint name="fl_steering_joint" type="hinge" axis="0 0 -1"
               range="-0.6109 0.6109"
               damping="5.0" armature="0.05"/>
        <inertial pos="0.00010411 0.0077919 -0.086394"
                  mass="2.1046"
                  fullinertia="0.0077836 0.0012676 0.007923 1.57e-8 1.35e-6 3.33e-6"/>
        <geom name="fl_knuckle" type="cylinder" size="0.025 0.06"
              pos="0 0 -0.06" material="steering_mat"
              contype="0" conaffinity="0"/>

        <body name="fl_wheel_link" pos="0 -0.001 -0.29345">
          <joint name="fl_wheel_joint" type="hinge" axis="0 1 0"
                 limited="false" damping="0.5"/>
          <inertial pos="0.000311 0 -0.002099"
                    mass="11.4679"
                    fullinertia="0.05332 0.08008 0.11423 3.01e-9 8.27e-7 2.15e-7"/>
          <geom name="fl_wheel_col" type="cylinder" size="0.160 0.055"
                euler="1.5708 0 0" material="wheel_mat"/>
        </body>
      </body>

      <!-- ═══════════ REAR-LEFT CORNER ═════════════════════════════════════
           Steering mount: x=-0.445  y= 0.280  z= 0.0335
      -->
      <body name="rl_steering_wheel_link" pos="-0.445 0.280 0.0335">
        <joint name="rl_steering_joint" type="hinge" axis="0 0 -1"
               range="-0.6109 0.6109"
               damping="5.0" armature="0.05"/>
        <inertial pos="0.000105 0.007473 -0.085165"
                  mass="2.09214"
                  fullinertia="0.007783 0.001266 0.007922 1.57e-8 1.35e-6 3.33e-6"/>
        <geom name="rl_knuckle" type="cylinder" size="0.025 0.06"
              pos="0 0 -0.06" material="steering_mat"
              contype="0" conaffinity="0"/>

        <body name="rl_wheel_link" pos="0 -0.001 -0.29345">
          <joint name="rl_wheel_joint" type="hinge" axis="0 1 0"
                 limited="false" damping="0.5"/>
          <inertial pos="0.000311 0 -0.002099"
                    mass="11.4679"
                    fullinertia="0.05332 0.08008 0.11423 3.01e-9 8.27e-7 2.15e-7"/>
          <geom name="rl_wheel_col" type="cylinder" size="0.160 0.055"
                euler="1.5708 0 0" material="wheel_mat"/>
        </body>
      </body>

      <!-- ═══════════ REAR-RIGHT CORNER ════════════════════════════════════
           Steering mount: x=-0.445  y=-0.280  z= 0.0335
      -->
      <body name="rr_steering_wheel_link" pos="-0.445 -0.280 0.0335">
        <joint name="rr_steering_joint" type="hinge" axis="0 0 -1"
               range="-0.6109 0.6109"
               damping="5.0" armature="0.05"/>
        <inertial pos="0.000105 0.007473 -0.085165"
                  mass="2.09214"
                  fullinertia="0.007783 0.001266 0.007922 1.57e-8 1.35e-6 3.33e-6"/>
        <geom name="rr_knuckle" type="cylinder" size="0.025 0.06"
              pos="0 0 -0.06" material="steering_mat"
              contype="0" conaffinity="0"/>

        <body name="rr_wheel_link" pos="0 0.001 -0.2918">
          <joint name="rr_wheel_joint" type="hinge" axis="0 1 0"
                 limited="false" damping="0.5"/>
          <inertial pos="-0.000951 0 0.002095"
                    mass="11.4679"
                    fullinertia="0.05332 0.08008 0.11423 3.09e-9 8.27e-7 2.15e-7"/>
          <geom name="rr_wheel_col" type="cylinder" size="0.160 0.055"
                euler="1.5708 0 0" material="wheel_mat"/>
        </body>
      </body>

    </body> <!-- /base_link -->

  </worldbody>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ACTUATORS
       ─────────────────────────────────────────────────────────────────────
       Steering: position actuators (kp=100) → target angle in radians
       Drive:    velocity actuators (kv=60)  → target wheel speed in rad/s

       Order  (IMPORTANT — matches Python ctrl[] indexing):
         ctrl[0]  act_fl_steer   fl_steering_joint
         ctrl[1]  act_fr_steer   fr_steering_joint
         ctrl[2]  act_rl_steer   rl_steering_joint
         ctrl[3]  act_rr_steer   rr_steering_joint
         ctrl[4]  act_fl_drive   fl_wheel_joint
         ctrl[5]  act_fr_drive   fr_wheel_joint
         ctrl[6]  act_rl_drive   rl_wheel_joint
         ctrl[7]  act_rr_drive   rr_wheel_joint
  ═══════════════════════════════════════════════════════════════════════════ -->
  <actuator>
    <!-- Steering position actuators -->
    <position name="act_fl_steer" joint="fl_steering_joint" kp="100"
              ctrlrange="-0.6109 0.6109"/>
    <position name="act_fr_steer" joint="fr_steering_joint" kp="100"
              ctrlrange="-0.6109 0.6109"/>
    <position name="act_rl_steer" joint="rl_steering_joint" kp="100"
              ctrlrange="-0.6109 0.6109"/>
    <position name="act_rr_steer" joint="rr_steering_joint" kp="100"
              ctrlrange="-0.6109 0.6109"/>

    <!-- Wheel velocity actuators -->
    <velocity name="act_fl_drive" joint="fl_wheel_joint" kv="60"/>
    <velocity name="act_fr_drive" joint="fr_wheel_joint" kv="60"/>
    <velocity name="act_rl_drive" joint="rl_wheel_joint" kv="60"/>
    <velocity name="act_rr_drive" joint="rr_wheel_joint" kv="60"/>
  </actuator>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SENSORS
       ─────────────────────────────────────────────────────────────────────
       IMU:         3-axis accelerometer + 3-axis gyroscope
       Wheel odometry: joint-velocity sensors for each drive wheel
  ═══════════════════════════════════════════════════════════════════════════ -->
  <sensor>
    <!-- IMU: accelerometer (m/s²) -->
    <accelerometer name="imu_accel" site="imu_site"/>
    <!-- IMU: gyroscope (rad/s) -->
    <gyro name="imu_gyro" site="imu_site"/>

    <!-- Wheel velocity feedback (rad/s) -->
    <jointvel name="fl_wheel_vel" joint="fl_wheel_joint"/>
    <jointvel name="fr_wheel_vel" joint="fr_wheel_joint"/>
    <jointvel name="rl_wheel_vel" joint="rl_wheel_joint"/>
    <jointvel name="rr_wheel_vel" joint="rr_wheel_joint"/>

    <!-- Steering angle feedback (rad) -->
    <jointpos name="fl_steer_pos" joint="fl_steering_joint"/>
    <jointpos name="fr_steer_pos" joint="fr_steering_joint"/>
    <jointpos name="rl_steer_pos" joint="rl_steering_joint"/>
    <jointpos name="rr_steer_pos" joint="rr_steering_joint"/>
  </sensor>

</mujoco>
